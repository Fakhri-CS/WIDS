# Flask
FLASK_APP=wids:create_app
FLASK_DEBUG=1

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME

# PostgreSQL container
POSTGRES_DB=wids_db
POSTGRES_USER=wids_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Flask SQLAlchemy
DATABASE_URL=postgresql+psycopg://wids_user:CHANGE_ME@localhost:5432/wids_db
